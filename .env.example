# KRITAM Environment Configuration

# Backend Server Configuration
KRITAM_BACKEND_HOST=127.0.0.1
KRITAM_BACKEND_PORT=8765
KRITAM_ENV=development

# Security
# Set by Electron at runtime if omitted
KRITAM_AUTH_TOKEN=

# AI Provider Configuration (Optional - can be configured in UI)
# Supported providers: offline, ollama, openai, groq, openrouter
DEFAULT_AI_PROVIDER=offline
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:latest

# Cloud AI keys. If entered in Settings, current versions store them in SQLite without OS-backed encryption.
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_MODEL=gpt-4o-mini
